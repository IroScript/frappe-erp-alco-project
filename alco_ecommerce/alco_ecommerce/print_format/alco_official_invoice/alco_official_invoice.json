 "doctype": "Print Format",
 "font_size": 14,
 "html": "<style>\n    .invoice-card {\n        font-family: 'Segoe UI', Arial, sans-serif;\n        color: #1f2937;\n        padding: 30px;\n        background: #ffffff;\n        border: 1px solid #e5e7eb;\n        border-radius: 8px;\n    }\n    .header-table {\n        width: 100%;\n        border-collapse: collapse;\n        margin-bottom: 25px;\n    }\n    .company-logo {\n        font-size: 26px;\n        font-weight: 800;\n        color: #0284c7;\n        letter-spacing: -0.5px;\n    }\n    .company-subtitle {\n        font-size: 13px;\n        color: #6b7280;\n        font-weight: 500;\n    }\n    .invoice-title {\n        font-size: 24px;\n        font-weight: 700;\n        color: #0f172a;\n        text-align: right;\n    }\n    .meta-box {\n        background: #f8fafc;\n        border: 1px solid #f1f5f9;\n        border-radius: 6px;\n        padding: 15px;\n        margin-bottom: 25px;\n    }\n    .meta-table {\n        width: 100%;\n        font-size: 13px;\n    }\n    .meta-table td {\n        padding: 4px 8px;\n    }\n    .items-table {\n        width: 100%;\n        border-collapse: collapse;\n        margin-bottom: 25px;\n    }\n    .items-table th {\n        background: #0284c7;\n        color: #ffffff;\n        text-align: left;\n        padding: 10px 12px;\n        font-size: 13px;\n        font-weight: 600;\n    }\n    .items-table td {\n        padding: 10px 12px;\n        border-bottom: 1px solid #e2e8f0;\n        font-size: 13px;\n    }\n    .total-box {\n        width: 40%;\n        float: right;\n        margin-bottom: 30px;\n    }\n    .total-table {\n        width: 100%;\n        font-size: 14px;\n    }\n    .total-table td {\n        padding: 6px 12px;\n    }\n    .grand-total {\n        font-size: 16px;\n        font-weight: 700;\n        color: #0284c7;\n        border-top: 2px solid #0284c7;\n    }\n    .footer-stamp {\n        margin-top: 60px;\n        width: 100%;\n        clear: both;\n    }\n    .stamp-col {\n        width: 33%;\n        float: left;\n        text-align: center;\n        font-size: 12px;\n        color: #64748b;\n    }\n    .stamp-line {\n        border-top: 1px dashed #94a3b8;\n        margin-bottom: 8px;\n        width: 80%;\n        margin-left: 10%;\n    }\n</style>\n\n<div class=\"invoice-card\">\n    <table class=\"header-table\">\n        <tr>\n            <td>\n                <div class=\"company-logo\">ALCO PHARMA LTD.</div>\n                <div class=\"company-subtitle\">Pharmaceutical Manufacturing & Distribution</div>\n                <div style=\"font-size: 12px; color: #64748b; margin-top: 4px;\">Plot 42, Tejgaon I/A, Dhaka-1208, Bangladesh</div>\n            </td>\n            <td style=\"vertical-align: top;\">\n                <div class=\"invoice-title\">OFFICIAL INVOICE</div>\n                <div style=\"text-align: right; font-size: 13px; color: #64748b;\">Invoice No: <strong>{{ doc.name }}</strong></div>\n                <div style=\"text-align: right; font-size: 13px; color: #64748b;\">Date: {{ doc.get_formatted('order_date') }}</div>\n            </td>\n        </tr>\n    </table>\n\n    <div class=\"meta-box\">\n        <table class=\"meta-table\">\n            <tr>\n                <td><strong>Field Agent:</strong> {{ doc.field_agent_name }}</td>\n                <td><strong>Chemist / Doctor:</strong> {{ doc.chemist_doctor_name }}</td>\n            </tr>\n            <tr>\n                <td><strong>Territory / Region:</strong> {{ doc.territory_region }}</td>\n                <td><strong>Payment Method:</strong> {{ doc.payment_method }}</td>\n            </tr>\n            <tr>\n                <td><strong>Status:</strong> <span style=\"color: #0284c7; font-weight: 600;\">{{ doc.status }}</span></td>\n                <td><strong>Remarks:</strong> {{ doc.remarks or 'N/A' }}</td>\n            </tr>\n        </table>\n    </div>\n\n    <table class=\"items-table\">\n        <thead>\n            <tr>\n                <th style=\"width: 5%;\">#</th>\n                <th style=\"width: 35%;\">Item Description</th>\n                <th style=\"width: 15%;\">Batch No</th>\n                <th style=\"width: 15%;\">Expiry</th>\n                <th style=\"width: 10%; text-align: right;\">Qty</th>\n                <th style=\"width: 10%; text-align: right;\">Rate (৳)</th>\n                <th style=\"width: 10%; text-align: right;\">Amount (৳)</th>\n            </tr>\n        </thead>\n        <tbody>\n            {% for item in doc.items %}\n            <tr>\n                <td>{{ loop.index }}</td>\n                <td><strong>{{ item.item_name }}</strong><br><small style=\"color: #64748b;\">{{ item.item_code }}</small></td>\n                <td>{{ item.batch_no or 'N/A' }}</td>\n                <td>{{ item.expiry_date or 'N/A' }}</td>\n                <td style=\"text-align: right;\">{{ item.qty }}</td>\n                <td style=\"text-align: right;\">{{ item.get_formatted('rate') }}</td>\n                <td style=\"text-align: right;\"><strong>{{ item.get_formatted('amount') }}</strong></td>\n            </tr>\n            {% endfor %}\n        </tbody>\n    </table>\n\n    <div class=\"total-box\">\n        <table class=\"total-table\">\n            <tr class=\"grand-total\">\n                <td>Grand Total:</td>\n                <td style=\"text-align: right;\">৳ {{ doc.get_formatted('grand_total') }}</td>\n            </tr>\n        </table>\n    </div>\n\n    <div class=\"footer-stamp\">\n        <div class=\"stamp-col\">\n            <div class=\"stamp-line\"></div>\n            Prepared By (Agent)\n        </div>\n        <div class=\"stamp-col\">\n            <div class=\"stamp-line\"></div>\n            Verified By (Accounts)\n        </div>\n        <div class=\"stamp-col\">\n            <div class=\"stamp-line\"></div>\n            Authorized Signature\n        </div>\n    </div>\n</div>",
 "line_breaks": 0,
