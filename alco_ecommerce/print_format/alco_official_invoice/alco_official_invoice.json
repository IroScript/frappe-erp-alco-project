{
 "align_labels_right": 0,
 "creation": "2026-08-12 12:00:00.000000",
 "custom_format": 1,
 "disabled": 0,
 "doc_type": "Alco Field Order",
 "docstatus": 0,
 "doctype": "Print Format",
 "font_size": 14,
 "html": "<style>\n    .customer-order-book {\n        font-family: 'Roboto', Arial, sans-serif;\n        color: #000000;\n        background: #ffffff;\n        padding: 20px 25px;\n        font-size: 12px;\n    }\n    .top-row {\n        display: flex;\n        justify-content: space-between;\n        align-items: flex-start;\n        margin-bottom: 20px;\n    }\n    .logo-box {\n        display: flex;\n        align-items: center;\n        gap: 6px;\n        margin-bottom: 8px;\n    }\n    .company-address {\n        font-size: 12px;\n        line-height: 1.5;\n        color: #000;\n    }\n    .order-meta-box {\n        border: 1px solid #000;\n        padding: 6px 12px;\n        font-size: 12px;\n        line-height: 1.6;\n        min-width: 240px;\n    }\n    .middle-row {\n        display: flex;\n        justify-content: space-between;\n        align-items: flex-start;\n        margin-bottom: 16px;\n    }\n    .market-box {\n        border: 1px solid #000;\n        padding: 6px 12px;\n        font-size: 12px;\n        line-height: 1.7;\n        width: 46%;\n    }\n    .customer-info-box {\n        border: 1px solid #000;\n        font-size: 12px;\n        width: 48%;\n    }\n    .customer-info-box .box-title {\n        text-align: center;\n        font-weight: bold;\n        padding: 3px 0;\n        border-bottom: 1px solid #000;\n        font-size: 12px;\n    }\n    .customer-info-box .box-content {\n        padding: 6px 12px;\n        line-height: 1.7;\n    }\n    .section-divider {\n        border-top: 1px solid #000;\n        margin: 14px 0 10px 0;\n    }\n    .order-book-title {\n        font-weight: bold;\n        font-size: 13px;\n        letter-spacing: 0.5px;\n        color: #000;\n        margin-bottom: 10px;\n    }\n    .items-table {\n        width: 100%;\n        border-collapse: collapse;\n        font-size: 12px;\n        margin-bottom: 20px;\n    }\n    .items-table th {\n        text-align: left;\n        font-size: 11px;\n        font-weight: bold;\n        vertical-align: bottom;\n        padding: 6px 4px;\n        color: #000;\n        border-bottom: 1px solid #cbd5e1;\n    }\n    .items-table td {\n        padding: 8px 4px;\n        color: #000;\n        border-bottom: 1px solid #f1f5f9;\n    }\n    .items-table tfoot td {\n        font-weight: bold;\n        font-size: 12px;\n        padding: 10px 4px;\n        border-top: 1px solid #cbd5e1;\n        border-bottom: none;\n    }\n    .signature-section {\n        margin-top: 80px;\n        display: flex;\n        justify-content: space-between;\n        padding: 0 10px;\n        font-size: 12px;\n        color: #000;\n    }\n    .signature-block {\n        border-top: 1px solid #000;\n        width: 180px;\n        text-align: center;\n        padding-top: 6px;\n    }\n</style>\n\n<div class=\"customer-order-book\">\n    <div class=\"top-row\">\n        <div>\n            <div class=\"logo-box\">\n                <img src=\"/assets/alco_ecommerce/images/alco_logo_blue.png\" alt=\"Alco Pharma Ltd.\" style=\"height:46px; width:auto; max-width:240px; display:block; margin-bottom:6px; object-fit:contain;\">\n            </div>\n            <div class=\"company-address\">\n                <div>H: 21, R: 113/A</div>\n                <div>Gulshan 2, Dhaka 1212</div>\n                <div>Phone: 01955333555</div>\n            </div>\n        </div>\n\n        <div class=\"order-meta-box\">\n            <div style=\"display:flex;\"><span style=\"width:90px;\">Order ID</span><span>: {{ doc.name }}</span></div>\n            <div style=\"display:flex;\"><span style=\"width:90px;\">Order Date</span><span>: {{ doc.get_formatted('order_date') }}</span></div>\n        </div>\n    </div>\n\n    <div class=\"middle-row\">\n        <div class=\"market-box\">\n            <div style=\"display:flex;\"><span style=\"width:75px;\">Market</span><span>: {{ doc.market or doc.territory_region or 'DOMAR' }}</span></div>\n            <div style=\"display:flex;\"><span style=\"width:75px;\">MPO</span><span>: {{ doc.mpo or doc.field_agent_name or 'SHAMAL CHANDRA RAY' }}</span></div>\n            <div style=\"display:flex;\"><span style=\"width:75px;\">DA</span><span>: {{ doc.da or 'A.H KAFI' }}</span></div>\n        </div>\n\n        <div class=\"customer-info-box\">\n            <div class=\"box-title\">Customer Info</div>\n            <div class=\"box-content\">\n                <div style=\"display:flex;\"><span style=\"width:115px;\">Customer Name</span><span>: {{ doc.chemist_doctor_name }}</span></div>\n                <div style=\"display:flex;\"><span style=\"width:115px;\">Phone Number</span><span>: {{ doc.phone_number or '01774502999' }}</span></div>\n                <div style=\"display:flex;\"><span style=\"width:115px;\">Thana</span><span>: {{ doc.thana or 'Domar' }}</span></div>\n                <div style=\"display:flex;\"><span style=\"width:115px;\">Zone</span><span>: {{ doc.zone or 'RNG.A1' }}</span></div>\n                <div style=\"display:flex;\"><span style=\"width:115px;\">MPO Code</span><span>: {{ doc.mpo_code or 'J002' }}</span></div>\n                <div style=\"display:flex;\"><span style=\"width:115px;\">Pharmacy Code</span><span>: {{ doc.pharmacy_code or '010023' }}</span></div>\n            </div>\n        </div>\n    </div>\n\n    <div class=\"section-divider\"></div>\n    <div class=\"order-book-title\">CUSTOMER ORDER BOOK</div>\n\n    <table class=\"items-table\">\n        <thead>\n            <tr>\n                <th style=\"width:4%; text-align:left;\">SL</th>\n                <th style=\"width:22%; text-align:left;\">PRODUCT</th>\n                <th style=\"width:22%; text-align:left; line-height:1.2;\">STRENGTH/ PACK<br>SIZE</th>\n                <th style=\"width:10%; text-align:right;\">MRP (TK.)</th>\n                <th style=\"width:11%; text-align:right;\">OFFER PRICE</th>\n                <th style=\"width:9%; text-align:center; line-height:1.2;\">ORDER<br>QUANTITY</th>\n                <th style=\"width:11%; text-align:right; line-height:1.2;\">DISCOUNTED<br>AMOUNT</th>\n                <th style=\"width:11%; text-align:right;\">PAYABLE</th>\n            </tr>\n        </thead>\n        <tbody>\n            {% for item in doc.items %}\n            <tr>\n                <td style=\"text-align:left;\">{{ loop.index }}</td>\n                <td style=\"text-align:left;\">{{ item.item_name }}</td>\n                <td style=\"text-align:left;\">{{ item.pack_size or item.description or \"8 mg Tablet [30's]\" }}</td>\n                <td style=\"text-align:right;\">{{ '%.2f'|format(item.mrp or (item.rate * 1.45)) }}</td>\n                <td style=\"text-align:right;\">{{ '%.2f'|format(item.rate) }}</td>\n                <td style=\"text-align:center;\">{{ item.qty }}</td>\n                <td style=\"text-align:right;\">{{ '%.2f'|format((item.rate - (item.mrp or (item.rate * 1.45))) * item.qty) }}</td>\n                <td style=\"text-align:right;\">{{ '%.2f'|format(item.rate * item.qty) }}</td>\n            </tr>\n            {% endfor %}\n        </tbody>\n        <tfoot>\n            <tr>\n                <td colspan=\"5\" style=\"text-align:right;\">Net Payable [VAT Included]</td>\n                <td style=\"text-align:center;\">{{ doc.total_qty or doc.items|sum(attribute='qty') }}</td>\n                <td style=\"text-align:right;\">{{ '%.2f'|format(doc.discount_amount or -93.0) }}</td>\n                <td style=\"text-align:right;\">{{ doc.get_formatted('grand_total') }}</td>\n            </tr>\n        </tfoot>\n    </table>\n\n    <div class=\"signature-section\">\n        <div class=\"signature-block\">Customer Signature</div>\n        <div class=\"signature-block\">Authorised signature</div>\n    </div>\n</div>",
 "line_breaks": 0,
 "margin_bottom": 15.0,
 "margin_left": 15.0,
 "margin_right": 15.0,
